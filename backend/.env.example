GEMINI_API_KEY=your-gemini-api-key
# Optional overrides
# TEXT_MODEL=gemini-3.8-flash
# IMAGE_MODEL=gemini-3.1-flash-image
# TTS_MODEL=gemini-3.8-flash-tts
# TTS_VOICE=Kore
PEXELS_API_KEY=your-pexels-api-key
# Veo clips per video (0 = stock footage only). Veo quota is small on low API tiers.
# VEO_CLIPS_PER_VIDEO=3
# Paid extras (off by default): AI photos for every scene, AI background music.
# GENERATE_SCENE_IMAGES=true
# GENERATE_MUSIC=true
